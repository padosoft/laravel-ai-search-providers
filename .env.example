# Live API keys for the opt-in E2E suite under tests/E2E/.
# Without these set, the live tests skip cleanly. Never commit real
# secret values — `.env` (without the .example suffix) is gitignored.

# Brave Search — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Tavily — https://docs.tavily.com
TAVILY_API_KEY=
TAVILY_URL=https://api.tavily.com

# Exa.ai — https://exa.ai/docs
EXA_API_KEY=
EXA_URL=https://api.exa.ai

# Firecrawl — https://docs.firecrawl.dev
FIRECRAWL_API_KEY=
FIRECRAWL_URL=https://api.firecrawl.dev

# WebSearchAPI.ai — https://websearchapi.ai/docs
WEBSEARCHAPI_API_KEY=
WEBSEARCHAPI_URL=https://api.websearchapi.ai

# DuckDuckGo HTML lite — no key required. Optional override:
# DUCKDUCKGO_URL=https://html.duckduckgo.com
