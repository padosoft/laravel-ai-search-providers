{
  "name": "laravel-ai-search-providers-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/@docmd/core/dist/bin/docmd.js dev --config docs-site/docmd.config.json",
    "build": "node node_modules/@docmd/core/dist/bin/docmd.js build --config docs-site/docmd.config.json",
    "check": "node scripts/check-no-raw-html.mjs && node node_modules/@docmd/core/dist/bin/docmd.js validate --config docs-site/docmd.config.json"
  },
  "devDependencies": {
    "@docmd/core": "0.8.6",
    "@huggingface/transformers": "^4.0.0",
    "docmd-search": "0.1.0-alpha.0",
    "onnxruntime-node": "1.27.0"
  }
}
